---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { t } from '../../../lib/i18n';

const locale = 'en' as const;
const ui = t(locale);

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = (await getCollection('blog-en', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(posts, { pageSize: 10 });
};

const { page } = Astro.props;
const total = page.total;
---

<BaseLayout title={`${ui.blog.title} - Page ${page.currentPage}`} description={ui.blog.title} locale={locale}>
  <header class="mb-12">
    <span class="b-tag b-bg-yellow mb-4">§ archive</span>
    <h1 class="display-1 mt-4 mb-3">{ui.blog.title}</h1>
    <p class="text-sm font-mono font-bold uppercase tracking-wider">
      [{total}] {total === 1 ? 'post' : 'posts'} total
    </p>
  </header>
  <div class="grid gap-6">
    {page.data.map((post) => <PostCard post={post} />)}
  </div>
  <Pagination page={page} locale={locale} />
</BaseLayout>