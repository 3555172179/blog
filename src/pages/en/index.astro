---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';
import { t, categoryPath, CATEGORIES, type Locale, type Category } from '../../lib/i18n';

const locale: Locale = 'en';
const ui = t(locale);

async function getRecentByCategory(category: Category, limit: number = 5) {
  const blog = await getCollection('blog-en', ({ data }) => !data.draft && data.category === category);
  const notes = await getCollection('notes-en', ({ data }) => !data.draft && data.category === category);
  return [
    ...blog.map((e) => ({ kind: 'blog' as const, date: e.data.pubDate, entry: e, title: e.data.title, tags: e.data.tags, description: e.data.description })),
    ...notes.map((e) => ({ kind: 'notes' as const, date: e.data.pubDate, entry: e, title: e.data.title, tags: e.data.tags })),
  ]
    .sort((a, b) => b.date.valueOf() - a.date.valueOf())
    .slice(0, limit);
}

const items = {
  work:  await getRecentByCategory('work'),
  study: await getRecentByCategory('study'),
  life:  await getRecentByCategory('life'),
};

const sectionTitles: Record<Category, string> = {
  work: ui.home.recentWork,
  study: ui.home.recentStudy,
  life: ui.home.recentLife,
};
const sectionViewAll: Record<Category, string> = {
  work: ui.home.viewWork,
  study: ui.home.viewStudy,
  life: ui.home.viewLife,
};
const sectionEmpty: Record<Category, string> = {
  work: ui.home.workEmpty,
  study: ui.home.studyEmpty,
  life: ui.home.lifeEmpty,
};

const avatarInitial = SITE.author.charAt(0).toUpperCase();
---

<BaseLayout description={ui.siteDesc} locale={locale} containerClass="max-w-5xl">
  <section class="relative pt-8 pb-28 mb-28 overflow-hidden">
    <!-- Background decorations: big yellow block top-left, small block bottom-right -->
    <div aria-hidden="true" class="absolute -top-8 -left-8 w-28 h-28 md:w-44 md:h-44 b-bg-yellow -rotate-12"></div>
    <div aria-hidden="true" class="absolute bottom-28 right-6 w-5 h-5 b-bg-yellow border-2 border-black dark:border-white rotate-6"></div>

    <!-- Top bar: v1.0 tag + yellow decorative block -->
    <div class="relative flex items-start justify-between mb-16">
      <span class="b-tag mt-1">v1.0</span>
      <span aria-hidden="true" class="w-14 h-14 md:w-20 md:h-20 b-bg-yellow border-2 border-black dark:border-white -rotate-6 shrink-0"></span>
    </div>

    <!-- Display title -->
    <h1 class="display-1 mb-8">
      {SITE.author.split('').map((ch) => (
        <span class="inline-block hover:-translate-y-2 transition-transform">{ch}</span>
      ))}
    </h1>

    <!-- Divider: thick black rule + yellow block -->
    <div class="flex items-center gap-4 mb-16">
      <div class="h-2 flex-1 bg-black dark:bg-white"></div>
      <span aria-hidden="true" class="w-8 h-8 b-bg-yellow border-2 border-black dark:border-white -rotate-3 shrink-0"></span>
    </div>

    <!-- Bio + avatar: side by side on desktop -->
    <div class="grid md:grid-cols-[1fr_auto] gap-10 items-start">
      <div class="relative inline-block max-w-2xl b-shadow-yellow">
        <div class="absolute -left-3 top-4 bottom-4 w-1.5 b-bg-yellow"></div>
        <div class="relative b-border bg-white dark:bg-[#0a0a0a] p-7 pl-10">
          <p class="text-xl leading-relaxed font-medium">
            {ui.bio}
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row md:flex-col gap-6 items-start">
        <div class="relative shrink-0">
          <div aria-hidden="true" class="absolute -inset-2 b-bg-yellow -rotate-3"></div>
          <img
            src={SITE.avatar}
            alt={SITE.author}
            width="140"
            height="140"
            class="relative w-[140px] h-[140px] object-cover b-border-2 bg-white"
            onerror={`this.onerror=null;this.replaceWith(Object.assign(document.createElement('div'),{className:'relative w-[140px] h-[140px] b-border-2 b-bg-yellow flex items-center justify-center text-6xl font-black text-black',textContent:'${avatarInitial}'}))`}
          />
        </div>

        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2">
            <span class="b-tag">find me</span>
            <span aria-hidden="true" class="font-mono text-xl">→</span>
          </div>
          <SocialLinks locale={locale} />
        </div>
      </div>
    </div>
  </section>

  {CATEGORIES.map((cat) => (
    <section class="mb-20">
      <div class="flex items-end justify-between mb-8 gap-4 flex-wrap">
        <div class="flex items-center gap-3">
          <span class={`b-tag ${cat === 'work' ? '' : 'b-bg-yellow'}`}>§ {cat}</span>
          <h2 class="display-2">{sectionTitles[cat]}</h2>
        </div>
        <a
          href={categoryPath(cat, locale)}
          class="b-btn"
        >
          {sectionViewAll[cat]} <span aria-hidden="true">→</span>
        </a>
      </div>
      {items[cat].length === 0 ? (
        <p class="b-border-2 b-bg-yellow p-8 inline-block font-black text-lg">{sectionEmpty[cat]}</p>
      ) : (
        <div class="grid gap-6">
          {items[cat].map((item) =>
            item.kind === 'blog' ? (
              <PostCard post={item.entry as any} />
            ) : (
              <a
                href={`/en/notes/${item.entry.id}/`}
                class="list-row group b-border-2 bg-white dark:bg-[#0a0a0a] flex items-baseline justify-between gap-4 px-6 py-5 text-lg hover:b-bg-yellow transition-colors"
              >
                <span class="font-bold">{item.title}</span>
                <time class="text-xs font-mono uppercase tracking-wider tabular-nums shrink-0">
                  {item.date.toLocaleDateString('en-CA')}
                </time>
              </a>
            )
          )}
        </div>
      )}
    </section>
  ))}

  <Subscribe locale={locale} />
</BaseLayout>
