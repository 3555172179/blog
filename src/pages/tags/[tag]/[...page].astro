---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { localePath, t } from '../../../lib/i18n';

const locale = 'zh' as const;
const ui = t(locale);

type Mixed = { kind: 'blog' | 'notes'; entry: CollectionEntry<'blog-zh'> | CollectionEntry<'notes-zh'> };

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const blog = await getCollection('blog-zh', ({ data }) => !data.draft);
  const notes = await getCollection('notes-zh', ({ data }) => !data.draft);

  const tagMap = new Map<string, Mixed[]>();
  const all = [
    ...blog.map<Mixed>((entry) => ({ kind: 'blog' as const, entry })),
    ...notes.map<Mixed>((entry) => ({ kind: 'notes' as const, entry })),
  ];
  for (const item of all) {
    for (const tag of item.entry.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, []);
      tagMap.get(tag)!.push(item);
    }
  }

  return [...tagMap.entries()].flatMap(([tag, items]) => {
    items.sort((a, b) => b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf());
    return paginate(items, {
      pageSize: 10,
      params: { tag },
      props: { tag, total: items.length },
    });
  });
};

const { page, tag, total } = Astro.props;
---

<BaseLayout title={`#${tag} - 第 ${page.currentPage} 页`} description={`标签 ${tag} 下的文章与笔记`} locale={locale}>
  <header class="mb-16">
    <a
      href={localePath('/tags', locale)}
      class="group inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider mb-8 hover:b-bg-yellow hover:px-2 transition-all"
    >
      <span aria-hidden="true" class="inline-block transition-transform group-hover:-translate-x-1">←</span>
      {ui.tags.back}
    </a>
    <span class="b-tag mb-6">§ tag</span>
    <h1 class="display-1 mt-6 mb-4">
      <span class="b-bg-yellow b-border-2 px-4 py-1 inline-block -rotate-1">#{tag}</span>
    </h1>
    <div class="flex items-center gap-3 mb-4">
      <span class="inline-block w-20 h-2 b-bg-yellow"></span>
      <span class="inline-block w-4 h-2 bg-black dark:bg-white"></span>
      <span class="inline-block w-2 h-2 bg-black dark:bg-white"></span>
    </div>
    <p class="text-sm font-mono font-black uppercase tracking-wider">
      [{total}] {locale === 'en' ? 'items' : '条'}
    </p>
  </header>

  <div class="space-y-8">
    {
      page.data.map((item: Mixed) => (
        <div>
          {item.kind === 'blog' ? (
            <PostCard post={item.entry as CollectionEntry<'blog-zh'>} />
          ) : (
            <a
              href={`/notes/${(item.entry as CollectionEntry<'notes-zh'>).id}/`}
              class="list-row group b-border-2 bg-white dark:bg-[#0a0a0a] flex items-baseline justify-between gap-4 px-6 py-5 text-lg hover:b-bg-yellow transition-colors"
            >
              <span class="font-bold">{(item.entry as CollectionEntry<'notes-zh'>).data.title}</span>
              <time class="text-xs font-mono font-bold uppercase tracking-wider shrink-0 tabular-nums">
                {(item.entry as CollectionEntry<'notes-zh'>).data.pubDate.toLocaleDateString('en-CA')}
              </time>
            </a>
          )}
        </div>
      ))
    }
  </div>

  <Pagination page={page} locale={locale} />
</BaseLayout>