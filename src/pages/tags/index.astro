---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localePath, t, CATEGORIES, type Locale } from '../../lib/i18n';

const locale: Locale = 'zh';
const ui = t(locale);

const blog = await getCollection('blog-zh', ({ data }) => !data.draft);
const notes = await getCollection('notes-zh', ({ data }) => !data.draft);

// 按 category 分组的 tag 计数
const tagsByCategory: Record<string, Map<string, number>> = {
  work:  new Map(),
  study: new Map(),
  life:  new Map(),
};
for (const item of [...blog, ...notes]) {
  const map = tagsByCategory[item.data.category];
  for (const tag of item.data.tags) {
    map.set(tag, (map.get(tag) ?? 0) + 1);
  }
}

const tagColors = ['b-bg-yellow', 'b-bg-black'];
const styleFor = (tag: string) => {
  let hash = 0;
  for (let i = 0; i < tag.length; i++) hash = (hash * 31 + tag.charCodeAt(i)) >>> 0;
  return tagColors[hash % 2];
};

const catLabel: Record<string, string> = {
  work:  ui.category.work,
  study: ui.category.study,
  life:  ui.category.life,
};
const catDesc: Record<string, string> = {
  work:  ui.category.workDesc,
  study: ui.category.studyDesc,
  life:  ui.category.lifeDesc,
};

const totalTags =
  tagsByCategory.work.size + tagsByCategory.study.size + tagsByCategory.life.size;
---

<BaseLayout title={ui.tags.title} description={ui.tags.description} locale={locale}>
  <header class="mb-12">
    <span class="b-tag mb-4">§ {locale === 'en' ? 'browse' : '分类'}</span>
    <h1 class="display-1 mt-4 mb-3">{ui.tags.title}</h1>
    <p class="text-sm leading-relaxed max-w-xl">
      {ui.tags.description}
    </p>
    <p class="text-sm font-mono font-bold uppercase tracking-wider mt-4">
      [{totalTags}] {locale === 'en' ? 'tags' : '个标签'} · 3 {locale === 'en' ? 'sections' : '个分类'}
    </p>
  </header>

  {CATEGORIES.map((cat) => {
    const entries = [...tagsByCategory[cat].entries()].sort((a, b) => b[1] - a[1]);
    if (entries.length === 0) return null;
    return (
      <section class="mb-10">
        <div class="flex items-baseline justify-between mb-5 gap-3 flex-wrap">
          <div class="flex items-center gap-3">
            <span class={`b-tag ${cat === 'work' ? '' : 'b-bg-yellow'}`}>§ {cat}</span>
            <h2 class="text-2xl font-black tracking-tight">{catLabel[cat]}</h2>
            <span class="text-xs font-mono font-bold uppercase tracking-wider opacity-60">
              [{entries.length}]
            </span>
          </div>
          <a
            href={localePath(`/${cat}`, locale)}
            class="text-xs font-bold uppercase tracking-wider hover:b-bg-yellow hover:px-2 transition-all"
          >
            {ui.home[`view${cat.charAt(0).toUpperCase() + cat.slice(1)}` as 'viewWork']} →
          </a>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4 max-w-xl">
          {catDesc[cat]}
        </p>
        <div class="flex flex-wrap items-start gap-3">
          {entries.map(([tag, n], i) => {
            const rotation = ['-rotate-2', 'rotate-1', '-rotate-1', 'rotate-2'][i % 4];
            return (
              <a
                href={localePath(`/tags/${encodeURIComponent(tag)}/`, locale)}
                class={`group inline-flex items-center gap-2 b-border-2 ${styleFor(tag)} px-2.5 py-1 ${rotation} hover:rotate-0 hover:scale-105 transition-transform font-black`}
              >
                <span>#{tag}</span>
                <span class="font-mono text-[10px] opacity-70">×{n}</span>
              </a>
            );
          })}
        </div>
      </section>
    );
  })}
</BaseLayout>