---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, t, categoryLabel, categoryDesc, type Locale, type Category } from '../lib/i18n';

const locale: Locale = 'zh';

type Props = { category: Category };
export const getStaticPaths = () => CATEGORIES.map((c) => ({ params: { category: c }, props: { category: c } }));

const { category } = Astro.props as Props;

const blogPosts = (await getCollection('blog-zh', ({ data }) => !data.draft && data.category === category))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const notePosts = (await getCollection('notes-zh', ({ data }) => !data.draft && data.category === category))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 用别名避免 JSX 里的 generics
type ZhBlog = CollectionEntry<'blog-zh'>;
type ZhNote = CollectionEntry<'notes-zh'>;

const items = [
  ...blogPosts.map((e) => ({ kind: 'blog' as const, entry: e as ZhBlog })),
  ...notePosts.map((e) => ({ kind: 'notes' as const, entry: e as ZhNote })),
].sort((a, b) => b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf());

const ui = t(locale);
const tagColorMap = ['b-bg-yellow', 'b-bg-black'];
const styleFor = (tag: string) => {
  let hash = 0;
  for (let i = 0; i < tag.length; i++) hash = (hash * 31 + tag.charCodeAt(i)) >>> 0;
  return tagColorMap[hash % 2];
};
---

<BaseLayout
  title={`${categoryLabel(category, locale)} · ${ui.siteTitle}`}
  description={categoryDesc(category, locale)}
  locale={locale}
>
  <header class="mb-16">
    <a href="/" class="group inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider mb-8 hover:b-bg-yellow hover:px-2 transition-all">
      <span aria-hidden="true" class="inline-block transition-transform group-hover:-translate-x-1">←</span>
      {ui.nav.home}
    </a>
    <span class={`b-tag ${category === 'work' ? '' : 'b-bg-yellow'} mb-6 inline-block`}>§ {category}</span>
    <h1 class="display-1 mt-6 mb-4">{categoryLabel(category, locale)}</h1>
    <div class="flex items-center gap-3 mb-4">
      <span class="inline-block w-20 h-2 b-bg-yellow"></span>
      <span class="inline-block w-4 h-2 bg-black dark:bg-white"></span>
      <span class="inline-block w-2 h-2 bg-black dark:bg-white"></span>
    </div>
    <p class="text-lg leading-relaxed max-w-xl font-medium">
      {categoryDesc(category, locale)}
    </p>
    <p class="text-sm font-mono font-black uppercase tracking-wider mt-4">
      [{items.length}] {locale === 'en' ? 'items' : '条'}
    </p>
  </header>

  {
    items.length === 0 ? (
      <p class="b-border-2 b-bg-yellow p-8 inline-block font-black text-lg">
        {category === 'work' ? ui.home.workEmpty : category === 'study' ? ui.home.studyEmpty : ui.home.lifeEmpty}
      </p>
    ) : (
      <div class="space-y-6">
        {items.map((item) => {
          if (item.kind === 'blog') {
            const post: ZhBlog = item.entry;
            return (
              <div>
                <PostCard post={post} />
                {post.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2 ml-1">
                    {post.data.tags.map((tag: string) => (
                      <span class={`b-tag-chip ${styleFor(tag)}`}>#{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            );
          } else {
            const note: ZhNote = item.entry;
            return (
              <a
                href={`/notes/${note.id}/`}
                class="list-row group b-border-2 bg-white dark:bg-[#0a0a0a] flex items-baseline justify-between gap-4 px-6 py-5 text-lg hover:b-bg-yellow transition-colors"
              >
                <span class="font-bold">{note.data.title}</span>
                <time class="text-xs font-mono font-bold uppercase tracking-wider shrink-0 tabular-nums">
                  {note.data.pubDate.toLocaleDateString('en-CA')}
                </time>
              </a>
            );
          }
        })}
      </div>
    )
  }
</BaseLayout>