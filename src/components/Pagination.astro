---
import { detectLocale, t, type Locale } from '../lib/i18n';

interface Props {
  page: { currentPage: number; lastPage: number; url: { prev?: string; next?: string; current: string } };
  locale?: Locale;
}
const { page, locale = detectLocale(Astro.url.pathname) } = Astro.props;
const { currentPage, lastPage, url } = page;
const ui = t(locale);
const baseBtn = 'inline-flex items-center gap-2 px-5 py-3 b-border-2 text-sm font-black uppercase tracking-wider transition-all';
const activeCls = 'hover:b-bg-yellow hover:text-black hover:-translate-y-1 hover:-rotate-1';
const disabledCls = 'opacity-30 cursor-not-allowed';
---
{lastPage > 1 && (
  <nav class="flex justify-center items-center gap-3 mt-12" aria-label="Pagination">
    {url.prev ? (
      <a href={url.prev} class={`${baseBtn} ${activeCls}`}>
        <span aria-hidden="true">←</span>{ui.pagination.prev.replace('← ', '')}
      </a>
    ) : (
      <span class={`${baseBtn} ${disabledCls}`}>
        <span aria-hidden="true">←</span>{ui.pagination.prev.replace('← ', '')}
      </span>
    )}
    <span class="px-4 py-2 b-border-2 b-bg-black text-white font-mono font-bold tabular-nums">
      {currentPage} / {lastPage}
    </span>
    {url.next ? (
      <a href={url.next} class={`${baseBtn} ${activeCls}`}>
        {ui.pagination.next.replace(' →', '')}<span aria-hidden="true">→</span>
      </a>
    ) : (
      <span class={`${baseBtn} ${disabledCls}`}>
        {ui.pagination.next.replace(' →', '')}<span aria-hidden="true">→</span>
      </span>
    )}
  </nav>
)}