---
const { post } = Astro.props;
const isEn = Astro.url.pathname.startsWith('/en');
const dateLabel = isEn
  ? post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).toUpperCase()
  : post.data.pubDate.toLocaleDateString('zh-CN');

const postUrl = isEn ? `/en/blog/${post.id}/` : `/blog/${post.id}/`;
---

<article class="group relative b-border-2 bg-white dark:bg-[#0a0a0a] b-shadow-black p-7 b-card">
  <div class="flex items-start justify-between gap-4 mb-4">
    <h2 class="text-[1.75rem] font-black leading-tight tracking-tight flex-1">
      <a href={postUrl} class="hover:b-bg-yellow px-1 -mx-1 transition-colors">
        {post.data.title}
      </a>
    </h2>
    <span aria-hidden="true" class="shrink-0 mt-1 inline-flex items-center justify-center w-10 h-10 b-border-2 group-hover:b-bg-yellow group-hover:translate-x-1 transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter">
        <path d="M5 12h14M13 5l7 7-7 7" />
      </svg>
    </span>
  </div>

  {
    post.data.description && (
      <p class="text-[15px] leading-relaxed mb-5 line-clamp-2">
        {post.data.description}
      </p>
    )
  }

  <div class="flex flex-wrap items-center gap-2 text-xs">
    <time
      datetime={post.data.pubDate.toISOString()}
      class="inline-flex items-center font-mono font-bold tracking-wider tabular-nums uppercase"
    >
      {dateLabel}
    </time>
    <span aria-hidden="true" class="opacity-30">/</span>
    <div class="flex flex-wrap items-center gap-1.5">
      {
        post.data.tags.map((t) => (
          <span class="b-tag-chip">
            #{t}
          </span>
        ))
      }
    </div>
  </div>
</article>