---
import SocialLinks from './SocialLinks.astro';
import { detectLocale, t, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? detectLocale(Astro.url.pathname);
const ui = t(locale);
const year = new Date().getFullYear();
---

<footer class="relative mt-32 overflow-hidden">
  {/* 装饰色块：更大、更张扬 */}
  <div aria-hidden="true" class="absolute -top-8 -right-8 w-40 h-40 md:w-56 md:h-56 b-bg-yellow -rotate-6"></div>
  <div aria-hidden="true" class="absolute top-16 right-52 w-4 h-4 bg-black dark:bg-white rotate-3"></div>
  <div aria-hidden="true" class="absolute bottom-12 left-6 w-3 h-3 b-bg-yellow border-2 border-black dark:border-white"></div>

  <div class="relative max-w-6xl mx-auto px-5 pt-28 pb-12">
    <h2 class="display-1 mb-16">
      {locale === 'en' ? (
        <>SAY<br /><span class="b-bg-yellow b-border-2 px-4 py-1 inline-block -rotate-2">HELLO.</span></>
      ) : (
        <>打个<br /><span class="b-bg-yellow b-border-2 px-4 py-1 inline-block -rotate-2">招呼。</span></>
      )}
    </h2>

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-10 mb-12">
      <div class="max-w-md">
        <p class="text-lg leading-relaxed font-medium">
          {ui.footer.intro}
        </p>
      </div>
      <SocialLinks locale={locale} />
    </div>

    <div class="b-rule mb-8"></div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-sm font-mono uppercase tracking-wider font-black">
      <span>© {year} {ui.siteTitle}.</span>
      <span class="b-tag">{ui.footer.builtWith}</span>
    </div>
  </div>
</footer>