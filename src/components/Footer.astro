---
import SocialLinks from './SocialLinks.astro';
import { detectLocale, t, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? detectLocale(Astro.url.pathname);
const ui = t(locale);
const year = new Date().getFullYear();
---

<footer class="relative mt-24 overflow-hidden">
  {/* 装饰色块：仅黄方块 + 黑色小点 */}
  <div aria-hidden="true" class="absolute top-0 right-0 w-32 h-32 b-bg-yellow"></div>
  <div aria-hidden="true" class="absolute top-12 right-44 w-3 h-3 bg-black dark:bg-white"></div>
  <div aria-hidden="true" class="absolute bottom-4 left-8 w-2 h-2 bg-black dark:bg-white"></div>

  <div class="relative max-w-6xl mx-auto px-5 pt-24 pb-12">
    <h2 class="display-2 mb-12">
      {locale === 'en' ? (
        <>SAY<br /><span class="b-bg-yellow b-border-2 px-3 inline-block -rotate-1">HELLO.</span></>
      ) : (
        <>打个<br /><span class="b-bg-yellow b-border-2 px-3 inline-block -rotate-1">招呼。</span></>
      )}
    </h2>

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 mb-10">
      <div class="max-w-md">
        <p class="text-base leading-relaxed">
          {ui.footer.intro}
        </p>
      </div>
      <SocialLinks locale={locale} />
    </div>

    <div class="h-[3px] bg-black dark:bg-white mb-6"></div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono uppercase tracking-wider">
      <span>© {year} {ui.siteTitle}.</span>
      <span class="b-tag">{ui.footer.builtWith}</span>
    </div>
  </div>
</footer>