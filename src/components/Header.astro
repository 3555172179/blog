---
import { SITE } from '../consts';
import LangSwitcher from './LangSwitcher.astro';
import { detectLocale, localePath, t, categoryPath, categoryLabel, CATEGORIES, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? detectLocale(Astro.url.pathname);
const ui = t(locale);

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { href: localePath('/', locale), label: ui.nav.home, match: localePath('/', locale) },
  { href: localePath('/blog', locale), label: ui.nav.blog, match: localePath('/blog', locale) },
  { href: localePath('/notes', locale), label: ui.nav.notes, match: localePath('/notes', locale) },
  { href: localePath('/tags', locale), label: ui.nav.tags, match: localePath('/tags', locale) },
];
const norm = (s: string) => (s === '/' ? '/' : s.replace(/\/$/, ''));
const isActive = (m: string) => {
  const p = norm(pathname);
  const mm = norm(m);
  return p === mm || p.startsWith(mm + '/');
};
const isCategoryActive = CATEGORIES.some((c) => norm(pathname) === norm(categoryPath(c, locale)));
const siteTitle = locale === 'en' ? ui.siteTitle : SITE.title;
---

<header class="sticky top-0 z-40 b-border-b bg-white dark:bg-[#0a0a0a]">
  <div class="max-w-6xl mx-auto px-5 h-20 flex items-center justify-between gap-3">
    {/* Logo — 与 favicon.svg 视觉一致（黄底黑边 Y + 两个角块） */}
    <a href={localePath('/', locale)} class="flex items-center gap-3 group shrink-0" aria-label={siteTitle}>
      <svg
        viewBox="0 0 64 64"
        class="h-12 w-12 shrink-0 group-hover:-rotate-6 transition-transform"
        aria-hidden="true"
      >
        <rect width="64" height="64" fill="#facc15" />
        <rect x="3" y="3" width="58" height="58" fill="none" stroke="#000" stroke-width="6" />
        <text x="32" y="44" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="36" font-weight="900" fill="#000" text-anchor="middle" letter-spacing="-1">Y</text>
        <rect x="50" y="6" width="6" height="6" fill="#000" />
        <rect x="8" y="50" width="6" height="6" fill="#000" />
      </svg>
      <span class="hidden sm:inline font-black tracking-tight text-xl uppercase whitespace-nowrap">{siteTitle}</span>
    </a>

    {/* 桌面 nav (md+)：完整导航 + search + theme */}
    <nav class="hidden md:flex items-center gap-1 text-xs font-bold uppercase tracking-wider">
      {navItems.slice(1).map((item) => (
        <a
          href={item.href}
          class={`hidden lg:inline-flex px-3 py-2 b-border transition-all items-center ${
            isActive(item.match)
              ? 'bg-black text-white dark:bg-white dark:text-black'
              : 'hover:b-bg-yellow hover:text-black hover:border-black'
          }`}
        >
          {item.label}
        </a>
      ))}

      {/* 分类下拉（桌面 hover/click 都生效） */}
      <div class="relative" data-dropdown>
        <button
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          data-dropdown-trigger
          class={`px-3 py-2 b-border transition-all inline-flex items-center gap-1.5 ${
            isCategoryActive
              ? 'bg-black text-white dark:bg-white dark:text-black'
              : 'hover:b-bg-yellow hover:text-black hover:border-black'
          }`}
        >
          {ui.nav.categories}
          <span aria-hidden="true" class="text-[10px]">▾</span>
        </button>
        <div
          data-dropdown-panel
          data-state="closed"
          class="invisible opacity-0 transition-opacity duration-150 absolute right-0 xl:left-0 top-full pt-2 z-50 data-[state=open]:visible data-[state=open]:opacity-100"
        >
          <div class="b-border-2 bg-white dark:bg-[#0a0a0a] min-w-[240px] b-shadow-yellow">
            <div class="px-4 pt-3 pb-2 border-b-2 border-black dark:border-white">
              <span class="b-tag">{ui.nav.categories}</span>
            </div>
            {CATEGORIES.map((c) => (
              <a
                href={categoryPath(c, locale)}
                class={`flex items-center gap-3 px-4 py-3 border-b-2 border-black dark:border-white last:border-b-0 hover:b-bg-yellow hover:text-black transition-colors ${
                  norm(pathname) === norm(categoryPath(c, locale)) ? 'b-bg-yellow' : ''
                }`}
              >
                <span class="inline-flex items-center justify-center w-7 h-7 b-border-2 font-black text-xs shrink-0">
                  {c === 'work' ? 'W' : c === 'study' ? 'S' : 'L'}
                </span>
                <span class="flex flex-col">
                  <span class="text-sm font-bold leading-tight">{categoryLabel(c, locale)}</span>
                  <span class="text-[10px] font-mono uppercase tracking-wider opacity-60 leading-tight">
                    {c === 'work' ? ui.categories.workDesc : c === 'study' ? ui.categories.studyDesc : ui.categories.lifeDesc}
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <span aria-hidden="true" class="hidden xl:inline mx-1 text-gray-300 dark:text-gray-700">|</span>

      {/* 搜索 + 主题：双端都显示在主 nav 上 */}
      <button
        type="button"
        data-search-trigger
        aria-label={ui.nav.search}
        class="w-10 h-10 inline-flex items-center justify-center b-border hover:b-bg-yellow hover:text-black transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
      </button>
      <button
        type="button"
        onclick="window.__toggleTheme()"
        aria-label={ui.theme.toggle}
        class="w-10 h-10 inline-flex items-center justify-center b-border hover:b-bg-yellow hover:text-black transition"
      >
        <svg class="dark:hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <LangSwitcher locale={locale} />
    </nav>

    {/* 移动端右侧控件 (md-)：logo + search + theme + lang + 汉堡，全部常驻 */}
    <div class="md:hidden flex items-center gap-1">
      <button
        type="button"
        data-search-trigger
        aria-label={ui.nav.search}
        class="w-10 h-10 inline-flex items-center justify-center b-border hover:b-bg-yellow hover:text-black transition"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
      </button>
      <button
        type="button"
        onclick="window.__toggleTheme()"
        aria-label={ui.theme.toggle}
        class="w-10 h-10 inline-flex items-center justify-center b-border hover:b-bg-yellow hover:text-black transition"
      >
        <svg class="dark:hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66zM4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <LangSwitcher locale={locale} />
      <button
        type="button"
        aria-label={locale === 'en' ? 'Open menu' : '打开菜单'}
        aria-expanded="false"
        data-mobile-menu-trigger
        class="w-10 h-10 inline-flex items-center justify-center b-border hover:b-bg-yellow hover:text-black transition"
      >
        {/* 汉堡图标 */}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  {/* 移动端抽屉菜单：只放导航项（Home/Blog/Notes/Tags + Categories），search/theme 已在主 nav 上 */}
  <div
    data-mobile-drawer
    data-state="closed"
    class="md:hidden border-t-2 border-black dark:border-white bg-white dark:bg-[#0a0a0a] hidden"
  >
    <nav class="px-4 py-3">
      <div class="px-2 py-2 mb-1 b-tag inline-block">§ {ui.nav.home}</div>
      <div class="flex flex-col mb-2">
        {navItems.slice(1).map((item) => (
          <a
            href={item.href}
            data-mobile-drawer-link
            class={`px-4 py-3 font-bold text-base border-b-2 border-black dark:border-white last:border-b-0 hover:b-bg-yellow hover:text-black transition-colors ${
              isActive(item.match) ? 'b-bg-yellow' : ''
            }`}
          >
            {item.label}
          </a>
        ))}
      </div>

      <div class="px-2 py-2 my-1 b-tag inline-block b-bg-yellow">§ {ui.nav.categories}</div>
      <div class="flex flex-col mb-2">
        {CATEGORIES.map((c) => (
          <a
            href={categoryPath(c, locale)}
            data-mobile-drawer-link
            class={`flex items-center gap-3 px-4 py-3 border-b-2 border-black dark:border-white last:border-b-0 hover:b-bg-yellow hover:text-black transition-colors ${
              norm(pathname) === norm(categoryPath(c, locale)) ? 'b-bg-yellow' : ''
            }`}
          >
            <span class="inline-flex items-center justify-center w-7 h-7 b-border-2 font-black text-xs shrink-0">
              {c === 'work' ? 'W' : c === 'study' ? 'S' : 'L'}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-bold leading-tight">{categoryLabel(c, locale)}</span>
              <span class="text-[10px] font-mono uppercase tracking-wider opacity-60 leading-tight">
                {c === 'work' ? ui.categories.workDesc : c === 'study' ? ui.categories.studyDesc : ui.categories.lifeDesc}
              </span>
            </span>
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  // ========== 分类下拉菜单（桌面端） ==========
  (function () {
    function setOpen(panel, open) {
      panel.setAttribute('data-state', open ? 'open' : 'closed');
      var trigger = panel.parentElement && panel.parentElement.querySelector('[data-dropdown-trigger]');
      if (trigger) trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    function closeAll() {
      document.querySelectorAll('[data-dropdown-panel][data-state="open"]').forEach(function (p) {
        setOpen(p, false);
      });
    }
    var hasHover = window.matchMedia('(hover: hover)').matches;
    document.querySelectorAll('[data-dropdown]').forEach(function (d) {
      if (hasHover) {
        d.addEventListener('mouseenter', function () {
          closeAll();
          var p = d.querySelector('[data-dropdown-panel]');
          if (p) setOpen(p, true);
        });
        d.addEventListener('mouseleave', function () {
          var p = d.querySelector('[data-dropdown-panel]');
          if (p) setOpen(p, false);
        });
      }
    });
    document.addEventListener('click', function (e) {
      var t = e.target;
      var trigger = t && t.closest && t.closest('[data-dropdown-trigger]');
      if (trigger) {
        e.preventDefault();
        var panel = trigger.parentElement && trigger.parentElement.querySelector('[data-dropdown-panel]');
        if (!panel) return;
        var isOpen = panel.getAttribute('data-state') === 'open';
        closeAll();
        if (!isOpen) setOpen(panel, true);
        return;
      }
      if (!(t && t.closest && t.closest('[data-dropdown]'))) closeAll();
    });
  })();

  // ========== 移动端抽屉菜单 ==========
  (function () {
    var trigger = document.querySelector('[data-mobile-menu-trigger]');
    var drawer = document.querySelector('[data-mobile-drawer]');
    if (!trigger || !drawer) return;
    function setDrawer(open) {
      drawer.setAttribute('data-state', open ? 'open' : 'closed');
      drawer.classList.toggle('hidden', !open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      // 汉堡 ↔ X 图标切换
      trigger.innerHTML = open
        ? '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>'
        : '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>';
    }
    trigger.addEventListener('click', function (e) {
      e.preventDefault();
      setDrawer(drawer.getAttribute('data-state') !== 'open');
    });
    drawer.addEventListener('click', function (e) {
      if (e.target.closest('[data-mobile-drawer-link]')) setDrawer(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.getAttribute('data-state') === 'open') setDrawer(false);
    });
  })();
</script>