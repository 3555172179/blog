---
import { SOCIAL_LINKS } from '../consts';
import { detectLocale, t, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? detectLocale(Astro.url.pathname);
void locale; void t;
---

<ul class="flex items-center gap-1.5">
  {
    SOCIAL_LINKS.map((s) => (
      <li>
        <a
          href={s.href}
          target={s.href.startsWith('http') ? '_blank' : undefined}
          rel={s.href.startsWith('http') ? 'me noopener' : undefined}
          aria-label={s.name}
          title={s.name}
          class={`inline-flex items-center justify-center w-11 h-11 b-border bg-white dark:bg-[#0a0a0a] text-black dark:text-white hover:-translate-y-1 hover:-rotate-6 hover:b-bg-yellow transition-all ${s.hover}`}
        >
          <Fragment set:html={s.svg} />
        </a>
      </li>
    ))
  }
</ul>