---
import { CUSDIS } from '../consts';
import { detectLocale, type Locale } from '../lib/i18n';

interface Props {
  pageId?: string;
  pageUrl?: string;
  pageTitle?: string;
  locale?: Locale;
}

const { pageId, pageUrl, pageTitle, locale = detectLocale(Astro.url.pathname) } = Astro.props;
const en = locale === 'en';

// 搁置状态：未启用时整个组件不渲染，不占版面。
// 启用方法：1) 去 cusdis.com 注册拿 appId；
//          2) 把 src/consts.ts 的 CUSDIS.appId 填好；
//          3) 把 enabled 改为 true —— UI 会自动出现。
---

{
  CUSDIS.enabled && (
    <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800">
      <h2 class="text-lg font-semibold mb-4">{en ? 'Comments' : '留言'}</h2>
      <div
        id="cusdis_thread"
        data-host={CUSDIS.host}
        data-app-id={CUSDIS.appId}
        data-page-id={pageId ?? ''}
        data-page-url={pageUrl ?? ''}
        data-page-title={pageTitle ?? ''}
        data-lang={en ? 'en' : 'zh-cn'}
      />
      <script async src={`${CUSDIS.host}/js/cusdis.count.js`} is:inline />
      <script async src={`${CUSDIS.host}/js/embed.js`} is:inline />
    </div>
  )
}